# JWT secret
JWT_SECRET=replace-me-with-a-strong-secret

# Twilio (optional - set to enable real SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TEST_PHONE=

# Redis (optional, defaults to localhost)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OTP settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Token expiry (seconds)
JWT_EXP_SECONDS=86400
